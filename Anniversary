           style="top:280px; right:-40px; width:144px; height:93px; transform:rotate(5deg);">

      <img class="decor-photo" src="https://i.imgur.com/Fy1mhff.png"
           alt="Placeholder 5"
           style="top:430px; left:-30px; width:98px; height:120px; transform:rotate(-4deg);">

      <img class="decor-photo" src="https://i.imgur.com/FSQoCMi.png"
           alt="Placeholder 6"
           style="bottom:-23px; right:0px; width:153px; height:214px;">

      <img class="decor-photo" src="https://i.imgur.com/IIuPwnp.png"
           alt="Placeholder 12"
           style="top:30px; left:-100px; width:188px; height:105px; transform:rotate(-8deg);">

      <img class="decor-photo" src="https://i.imgur.com/cVjK9W0.png"
