  <script>
    function goToStep(stepNumber) {
      const allSteps = document.querySelectorAll('.step');
      allSteps.forEach(step => step.classList.remove('active'));
      const nextStep = document.getElementById('step-' + stepNumber);
      if (nextStep) {
        nextStep.classList.add('active');
      }

      const mainCard = document.getElementById('mainCard');
      mainCard.classList.toggle('decor-visible', stepNumber === 1);

      if (stepNumber === 3) initQuiz();
      if (stepNumber === 4) initMemoryMatch();
    }

    let hasCollided = false;

    function triggerCollision() {
      if (hasCollided) return; 
      hasCollided = true;

      const row = document.getElementById('collisionRow');
      const btn = document.getElementById('revealBtn');
      const text = document.getElementById('centerText');

      row.classList.add('collided');

      setTimeout(() => {
        btn.classList.add('show');
        text.textContent = "Please press the bunny below to continue.";
      }, 5000);
    }

    const quizQuestions = [
      {
        question: "What's my favorite food?",
        options: ["Pizza", "Laing", "Siopao sa 7/11"],
        correct: 0
      },
      {
        question: "What's my favorite song right now?",
        options: ["Yeye Vonnel by April Boy Regino", "White Meadows by Bladee & Ecco2K", "Astronaut in the Ocean by Masked Wolf"],
        correct: 1
      },
      {
        question: "Do you love me?",
        options: ["Nope", "NO", "Yes sir"],
        correct: 2
      }
    ];

    let quizIndex = 0;
    let quizScore = 0;
    let quizInitialized = false;

    function initQuiz() {
      if (quizInitialized) return;
      quizInitialized = true;
      quizIndex = 0;
      quizScore = 0;
      renderQuizQuestion();
    }

    function renderQuizQuestion() {
      const container = document.getElementById('quizContainer');
      const progress = document.getElementById('quizProgress');
      const resultBox = document.getElementById('quizResult');

      if (quizIndex >= quizQuestions.length) {
        container.innerHTML = '';
        progress.textContent = '';
        resultBox.style.display = 'block';
        document.getElementById('quizScoreText').textContent =
          "Wowww " + quizScore + " out of " + quizQuestions.length + " score mo nice one";
        return;
      }

      const q = quizQuestions[quizIndex];
      progress.textContent = "Question " + (quizIndex + 1) + " of " + quizQuestions.length;

      let html = '<p class="quiz-question-text">' + q.question + '</p><div class="quiz-options">';
      q.options.forEach((opt, i) => {
        html += '<button class="quiz-option" onclick="answerQuiz(' + i + ')">' + opt + '</button>';
      });
      html += '</div>';
      container.innerHTML = html;
    }

    function answerQuiz(selectedIndex) {
      const q = quizQuestions[quizIndex];
      const buttons = document.querySelectorAll('#quizContainer .quiz-option');
      buttons.forEach(b => b.onclick = null);

      buttons[q.correct].classList.add('correct');
      if (selectedIndex !== q.correct) {
        buttons[selectedIndex].classList.add('wrong');
      } else {
        quizScore++;
      }

      setTimeout(() => {
        quizIndex++;
        renderQuizQuestion();
      }, 900);
    }

    let memoryInitialized = false;
    let memoryFlipped = [];
    let memoryMatchedCount = 0;
    let memoryLocked = false;

    const memoryPhotos = [
     "https://i.imgur.com/a5k0HyO.jpeg",
      "https://i.imgur.com/rvIUHAC.jpeg",
      "https://i.imgur.com/yyWJRVX.jpeg",
      "https://i.imgur.com/PHhJWYJ.jpeg",
      "https://i.imgur.com/LdPuMjy.jpeg",
      "https://i.imgur.com/UGfNA5b.jpeg",
      "https://i.imgur.com/s8mS4hS.jpeg",
      "https://i.imgur.com/C6jWV1N.jpeg"
    ];

    function initMemoryMatch() {
      if (memoryInitialized) return;
      memoryInitialized = true;

      const deck = [...memoryPhotos, ...memoryPhotos].sort(() => Math.random() - 0.5);

      const grid = document.getElementById('memoryGrid');
      grid.innerHTML = '';

      let deckIndex = 0;
      for (let i = 0; i < 16; i++) {
        const src = deck[deckIndex];
        deckIndex++;

        const el = document.createElement('div');
        el.className = 'memory-card';
        el.dataset.src = src;
        el.onclick = () => flipMemoryCard(el);
        grid.appendChild(el);
      }
    }

    function flipMemoryCard(el) {
      if (memoryLocked) return;
      if (el.classList.contains('flipped') || el.classList.contains('matched')) return;
      if (memoryFlipped.length === 2) return;

      el.classList.add('flipped');
      el.innerHTML = '<img class="memory-card-img" src="' + el.dataset.src + '" alt="Placeholder photo">';
      memoryFlipped.push(el);

      if (memoryFlipped.length === 2) {
        const [a, b] = memoryFlipped;
        if (a.dataset.src === b.dataset.src) {
          a.classList.add('matched');
          b.classList.add('matched');
          memoryFlipped = [];
          memoryMatchedCount++;
          if (memoryMatchedCount === memoryPhotos.length) {
            setTimeout(unlockScratchCard, 500);
          }
        } else {
          memoryLocked = true;
          setTimeout(() => {
            a.classList.remove('flipped');
            b.classList.remove('flipped');
            a.innerHTML = '';
            b.innerHTML = '';
            memoryFlipped = [];
            memoryLocked = false;
          }, 700);
        }
      }
    }

    function unlockScratchCard() {
      document.getElementById('memoryGrid').style.display = 'none';
      document.getElementById('step4Heading').textContent = 'Scratch to reveal your prize!';
      document.getElementById('step4Instructions').textContent = 'GOGOGOOGOGOGOOGOGO';
      document.getElementById('scratchWrap').style.display = 'block';
      initScratchCard();
    }

    let scratchInitialized = false;

    function initScratchCard() {
      if (scratchInitialized) return;
      scratchInitialized = true;

      const canvas = document.getElementById('scratchCanvas');
      const wrap = document.getElementById('scratchWrap');
      const ctx = canvas.getContext('2d');

      function sizeCanvas() {
        canvas.width = wrap.clientWidth;
        canvas.height = wrap.clientHeight;
        ctx.fillStyle = '#cfcfcf';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.font = "bold " + Math.floor(canvas.width / 14) + "px sans-serif";
        ctx.fillStyle = '#8a8a8a';
        ctx.textAlign = 'center';
        ctx.fillText('Scratch here!', canvas.width / 2, canvas.height / 2);
      }
      sizeCanvas();

      let isDrawing = false;
      let revealChecked = 0;

      function getPos(e) {
        const rect = canvas.getBoundingClientRect();
        const point = e.touches ? e.touches[0] : e;
        return {
          x: (point.clientX - rect.left) * (canvas.width / rect.width),
          y: (point.clientY - rect.top) * (canvas.height / rect.height)
        };
      }

      function scratchAt(x, y) {
        ctx.globalCompositeOperation = 'destination-out';
        ctx.beginPath();
        ctx.arc(x, y, 28, 0, Math.PI * 2);
        ctx.fill();
      }

      function checkRevealPercent() {
        revealChecked++;
        if (revealChecked % 8 !== 0) return;
        const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
        let transparent = 0;
        const total = data.length / 4;
        for (let i = 3; i < data.length; i += 4 * 20) {
          if (data[i] === 0) transparent++;
        }
        const percent = transparent / (total / 20);
        if (percent > 0.5) {
          canvas.style.opacity = '0';
          canvas.style.pointerEvents = 'none';
          document.getElementById('scratchContinue').style.display = 'block';
        }
      }

      function startDraw(e) {
        isDrawing = true;
        const p = getPos(e);
        scratchAt(p.x, p.y);
      }
      function moveDraw(e) {
        if (!isDrawing) return;
        e.preventDefault();
        const p = getPos(e);
        scratchAt(p.x, p.y);
        checkRevealPercent();
      }
      function endDraw() { isDrawing = false; }

      canvas.addEventListener('mousedown', startDraw);
      canvas.addEventListener('mousemove', moveDraw);
      canvas.addEventListener('mouseup', endDraw);
      canvas.addEventListener('mouseleave', endDraw);
      canvas.addEventListener('touchstart', startDraw);
      canvas.addEventListener('touchmove', moveDraw);
      canvas.addEventListener('touchend', endDraw);

      window.addEventListener('resize', sizeCanvas);
    }
  </script>

