        <div id="step-1" class="step active">

          <p class="custom-body-text" id="centerText">Happy 6th Anniversary, bunny!</p>

          <div class="animation-trigger">
            <div class="collision-row" id="collisionRow">
              <img class="collide-photo collide-left" src="https://i.imgur.com/shAhL22.png" alt="Placeholder 15">
              <img class="collide-photo collide-right" src="https://i.imgur.com/l4m9stU.png" alt="Placeholder 16">
